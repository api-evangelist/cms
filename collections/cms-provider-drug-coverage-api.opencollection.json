              {
                "name": "zipcode",
                "value": "",
                "type": "query",
                "description": "5-digit US zipcode"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Provider type, comma separated to specify multiple"
              }
            ]
          },
          "docs": "Autocomplete nearby providers"
        },
        {
          "info": {
            "name": "Search providers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/search",
            "params": [
              {
                "name": "apikey",
                "value": "",
                "type": "query",
                "description": "API key used for authentication"
              },
              {
                "name": "year",
                "value": "",
                "type": "query",
                "description": "4 digit market year (Defaults to the current year when not specified)."
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "search query"
              },
              {
                "name": "zipcode",
                "value": "",
                "type": "query",
                "description": "User's ZIP Code for searching nearby"
