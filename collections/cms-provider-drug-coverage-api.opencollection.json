              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Provider type, comma separated to specify multiple"
              },
              {
                "name": "specialty",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search providers"
        },
        {
          "info": {
            "name": "Get a list of whether a set of providers are covered by given plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/covered",
            "params": [
              {
                "name": "apikey",
                "value": "",
                "type": "query",
                "description": "API key used for authentication"
              },
              {
                "name": "providerids",
                "value": "",
                "type": "query",
                "description": "array of provider NPIs"
              },
              {
                "name": "planids",
                "value": "",
                "type": "query",
                "description": "array of plan IDs"
              },
              {
                "name": "year",
                "value": "",
                "type": "query",
                "description": "4 digit market year (Defaults to the current year when not specified)."
              }
            ]
          },
          "docs": "Get a list of whether a set of providers are covered by given plans"
        }
      ]
    }
  ],
  "bundled": true
}