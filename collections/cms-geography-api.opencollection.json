{
  "opencollection": "1.0.0",
  "info": {
    "name": "Marketplace API Reference Geography API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Geography",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /counties/by/zip/{zipcode}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/counties/by/zip/:zipcode",
            "params": [
              {
                "name": "apikey",
                "value": "",
                "type": "query",
                "description": "API key used for authentication"
              },
              {
                "name": "year",
                "value": "",
                "type": "query",
                "description": "4 digit market year (Defaults to the current year when not specified)."
              },
              {
                "name": "zipcode",
                "value": "",
                "type": "path",
                "description": "5 digit ZIP Code or 1-4 digit prefix of a ZIP Code"
              }
            ]
          },
          "docs": "Find counties matching ZIP Code (5 digits or prefix thereof).\nThis method is suitable for use in typeahead UI completions."
        },
        {
          "info": {
            "name": "GET /counties/{fips}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/counties/:fips",
            "params": [
              {
                "name": "apikey",
                "value": "",
                "type": "query",
                "description": "API key used for authentication"
              },
              {
                "name": "year",
                "value": "",
                "type": "query",
                "description": "4 digit market year (Defaults to the current year when not specified)."
              },
              {
                "name": "fips",
                "value": "",
                "type": "path",
                "description": "5-digit county FIPS code"
              }
            ]
          },
          "docs": "Get information about a county by its FIPS code."
